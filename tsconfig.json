{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": false,
    "strictPropertyInitialization": false,
    "noImplicitReturns": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "useDefineForClassFields": false,
    "baseUrl": "src",
    "paths": {
      "fast-bitset": [
        "app/util/bitset"
      ]
    },
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "target": "es2022",
    "lib": [
      "es2018",
      "dom"
    ]
  }
}
